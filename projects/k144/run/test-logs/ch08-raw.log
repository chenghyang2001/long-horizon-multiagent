  │         yes = sum(1 for a in ACC if judge(truth, a))
  │         items.append((truth, prop, yes))
  │     return items
  │ 
  │ def policy_rows(items):
  │     rules = [("any（提出者單方面寫）", lambda it: it[1]),
  │              ("majority（> 50%，≥ 5 票）", lambda it: it[2] >= 5),
  │              ("quorum66（≥ 66%，≥ 6 票）", lambda it: it[2] >= 6)]
