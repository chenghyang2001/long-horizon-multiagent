  │ 
  │ def run(policy):
  │     human = over = severe = low_fail = 0
  │     for a in alerts:
  │         if policy == "全部被動":
  │             mode = "human"
  │         elif policy == "全部主動":
  │             mode = "auto"
  │         elif policy == "依風險分級":
  │             mode = "human" if a["high"] else "auto"
  │         else:
  │             if a["high"] or (not a["real"] and a["u_check"] < 0.8):
  │                 mode = "human"
  │             else:
  │                 mode = "auto"
  │         if mode == "human":
  │             human += 1
  │             continue
  │         if not a["real"]:
  │             over += 1
  │         elif a["high"] and a["u_fix"] >= 0.6:
  │             severe += 1
  │         elif not a["high"] and a["u_fix"] >= 0.9:
  │             low_fail += 1
  │     return human, over, severe, low_fail
