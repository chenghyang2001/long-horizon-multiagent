  K144 第 4 章｜自組織與集體湧現　第 4 / 8 步
  練習 1：中央排程 vs 三條本地規則（η、T90、敏感度）
╚══════════════════════════════════════════════════════╝

💡 N = 20、60、120、200，每種跑 300 步。每步到達 Poisson(0.4N) 件、20 種類型，60% 從 20% 的入口節點進來。central：每步最多派 40 件、每 50 個節點多延遲 1 步。local：三條本地規則（同類合併、負載梯度、懲罰冷卻），每個節點只看隨機 4 個鄰居。第 150 步 15% 節點故障 30 步，central 的排程器另外停擺 10 步。T90 拿「同一組亂數、沒有故障」的對照跑法當基準，用 10 步移動平均，避免把到達量的隨機波動誤當成故障。結果寫到 ch04/interactive/self_org_warehouse.csv。

▶ 要執行的程式：
  │ import csv
  │ import math
  │ import os
  │ import random
  │ 
  │ random.seed(144)
  │ OUT = "ch04/interactive"
  │ os.makedirs(OUT, exist_ok=True)
  │ CSV_PATH = OUT + "/self_org_warehouse.csv"
  │ STEPS, TYPES, OK, C_MAX = 300, 20, 0.95, 40
  │ FAIL_AT, FAIL_LEN, STALL = 150, 30, 10
  │ SIZES = [20, 60, 120, 200]
  │ 
  │ def poisson(rng, lam):
  │     limit, k, p = math.exp(-lam), 0, 1.0
  │     while True:
  │         p *= rng.random()
  │         if p <= limit:
  │             return k
  │         k += 1
  │ 
  │ def make_world(n):
  │     rng = random.Random(1440 + n)
  │     entries = rng.sample(range(n), n // 5)
  │     failed = set(rng.sample(range(n), round(n * 0.15)))
  │     arrivals = []
  │     for t in range(STEPS):
  │         batch = []
  │         for _ in range(poisson(rng, 0.4 * n)):
  │             node = rng.choice(entries) if rng.random() < 0.6 else rng.randrange(n)
  │             batch.append((rng.randrange(TYPES), node))
  │         arrivals.append(batch)
  │     act = random.Random(2880 + n)
  │     draws = [[act.random() for _ in range(n)] for _ in range(STEPS)]
  │     nbrs = [[[j + (j >= i) for j in act.sample(range(n - 1), 4)] for i in range(n)] for _ in range(STEPS)]
  │     return failed, arrivals, draws, nbrs
  │ 
  │ def run_local(n, world, extra=0, fail=True):
  │     failed, arrivals, draws, nbrs = world
  │     if not fail:
  │         failed = set()
  │     q = [[i % TYPES] for i in range(n)]
  │     for _ in range(extra):
  │         q[0].append(TYPES - 1)
  │     fails, cool = [0] * n, [0] * n
  │     done = [0] * STEPS
  │     arrived = n + extra
  │     longest = 0
  │     snaps = {}
  │     for t in range(STEPS):
  │         down = failed if FAIL_AT <= t < FAIL_AT + FAIL_LEN else set()
  │         for typ, node in arrivals[t]:
  │             if cool[node] > 0:
  │                 node = nbrs[t][node][0]
  │             q[node].append(typ)
  │         arrived += len(arrivals[t])
  │         for i in range(n):                                  # 規則 b：負載梯度
  │             if i in down or cool[i] > 0:
  │                 continue
  │             nb = nbrs[t][i]
  │             avg = sum(len(q[j]) for j in nb) / 4
