  │ MU = 55
  │ SPIKE0, SPIKE1, SHIFT = 2420, 2435, 3600
  │ 
  │ def lam_at(t, after=50):
  │     if t < 360:
  │         return 60 - 12 * t / 360
  │     if SPIKE0 <= t < SPIKE1:
  │         return 120
  │     if t >= SHIFT:
  │         return after
  │     return 48
  │ 
  │ def poisson(lam):
  │     limit = math.exp(-lam)
  │     k, p = 0, 1.0
  │     while True:
  │         p *= random.random()
  │         if p <= limit:
  │             return k
  │         k += 1
  │ 
  │ def energy(L):
  │     return 0.4 * (L / 50) + 0.6 * ((L / MU) / 0.9)
  │ 
  │ def simulate(seed=7, after=50):
  │     random.seed(seed)
  │     q, E, Q = 0, [], []
  │     for t in range(4320):
  │         a = poisson(lam_at(t, after))
  │         served = min(q + a, MU)
  │         q = q + a - served
  │         E.append(energy(q + served))
  │         Q.append(q)
  │     return E, Q
