💡 兩大戶合計超過 50%，只要兩人意見一致，其他 9 位專家怎麼投都沒用。

▶ 要執行的程式：
  │ import random
  │ DOMAINS = ("數值", "合約", "情緒", "匯率")
  │ AGENTS = [DOMAINS[i % 4] for i in range(9)] + [None, None]
  │ 
  │ def acc(home, d):
  │     if home is None:
  │         return 0.52
  │     return 0.85 if home == d else 0.55
  │ 
  │ def run_token(s, n_q=2000):
  │     random.seed(303)
  │     w = [(1 - 2 * s) / 9] * 9 + [s, s]
  │     correct = 0
  │     for q in range(n_q):
  │         d = random.choice(DOMAINS)
  │         truth = random.randint(0, 1)
  │         votes = [truth if random.random() < acc(home, d) else 1 - truth for home in AGENTS]
  │         score = sum(wi if v == 1 else -wi for v, wi in zip(votes, w))
  │         if (1 if score > 0 else 0) == truth:
  │             correct += 1
  │     return correct / n_q, max(w) / sum(w)
  │ 
  │ print("(a) 代幣加權：每位大戶的代幣占比 vs 整體準確率（大戶準確率 0.52）")
