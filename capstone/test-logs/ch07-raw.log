  │     ("在允許清單內", lambda t: t.strip().strip(".").lower() in ALLOWED),
  │     ("答對 network", lambda t: t.strip().strip(".").lower() == "network"),
  │ ]
  │ client = anthropic.Anthropic()
  │ print("模型".ljust(18) + "性質通過｜output_tokens｜回答")
