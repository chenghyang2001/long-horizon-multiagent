  │     md += "| {} | {:.3f} | {:.2f} | {} | {:.4f} | {}/3 | {} |\n".format(r["seed"], r["polarization"], r["nn"], r["collisions"], r["lyapunov"], r["ok"], r["phase"])
  │ md += "\n## 判定\n\n- a. 5 次全達成 {} 次：{}（各目標達成率 {}/5、{}/5、{}/5）\n".format(full, verdict, *rate)
  │ md += "- b. 預言相 {} vs 實際相 {}：{}\n".format(expected, actual, "一致" if match else "不一致")
  │ md += "- c. " + cmp_text + "；較好：" + winner + "\n\n## 結論\n\n" + "\n".join("- " + s for s in lines) + "\n"
  │ (out / "rule_designer.md").write_text(md, encoding="utf-8")
  │ print()
  │ print("結論：")
  │ for s in lines:
  │     print("  " + s)
  │ print()
  │ print("已寫入", out / "rule_designer.md")
