  │ caught = rt.get("caught", "?"); total = rt.get("attacks", "?"); fp = rt.get("false_positives", "?")
  │ lines = ["# ch05 紅隊防火牆結果", "", f"偵測率：{caught}/{total}　誤報：{fp}", "", "| # | 類型 | 手法 | 防火牆 | 文字 |", "|---|---|---|---|---|"]
