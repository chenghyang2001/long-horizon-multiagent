  │ def gossip_rounds(regions=10, fanout=2):
  │     informed = {0}
  │     rounds = 0
  │     while len(informed) < regions:
  │         rounds += 1
  │         new = set()
  │         for node in sorted(informed):
  │             others = [x for x in range(regions) if x != node]
  │             new.update(random.sample(others, fanout))
  │         informed |= new
  │     return rounds
  │ 
