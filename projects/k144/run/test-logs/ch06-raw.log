  │ fin = rows[-1][1]
  │ result["saturated"] = {"k": 1.2, "final": fin}
  │ print(f"   → 沒有發散，三個代理都被壓在約 {sum(fin) / 3:.3f}：這是「飽和後跳到過載狀態」，不會自己回到 0")
  │ print()
  │ 
