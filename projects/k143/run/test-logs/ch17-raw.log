──── _score()（canary.py 第 39～56 行）────
  39  def _score(expect, output):
  40      if not expect:
  41          return 1.0
  42      out = (output or "").lower()
  43      checks = hits = 0
  44      for needle in expect.get("contains", []):
  45          checks += 1
  46          hits += needle.lower() in out
  47      if "exact" in expect:
  48          checks += 1
  49          hits += output.strip() == expect["exact"]
  50      if "min_len" in expect:
  51          checks += 1
  52          hits += len(output) >= expect["min_len"]
  53      if "max_len" in expect:
  54          checks += 1
  55          hits += len(output) <= expect["max_len"]
  56      return hits / checks if checks else 1.0

