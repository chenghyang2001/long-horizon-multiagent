  │           "錯誤訊息：requests.exceptions.ConnectTimeout: HTTPSConnectionPool(host=api.internal, "
  │           "port=443): Max retries exceeded (Caused by ConnectTimeoutError: timed out after 10s)")
  │ ALLOWED = {"bug", "config", "network"}
  │ checks = [
