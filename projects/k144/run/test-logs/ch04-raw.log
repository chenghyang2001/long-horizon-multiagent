💡 500 個寫作代理、12 個話題，排成一圈，每人只看左右各 3 位。20 輪、每輪 25 人決定寫什麼。權重 =（鄰居中寫該話題人數 + 1）×（平台累積篇數 + 1）^1.5。每個話題每輪審稿台只收 4 篇，多的退稿——用來看負載震盪。三種策略共用同一個決策順序與同一串亂數。結果寫到 ch04/interactive/herding_state.json。

▶ 要執行的程式：
  │ import json
  │ import os
  │ import random
  │ 
  │ random.seed(144)
  │ OUT = "ch04/interactive"
  │ os.makedirs(OUT, exist_ok=True)
  │ STATE = OUT + "/herding_state.json"
  │ TOPICS = ["AI 代理治理", "電動車補貼", "房價走勢", "減肥飲食", "職場霸凌", "颱風動態",
  │           "加密貨幣", "手搖飲漲價", "AI 取代工作", "旅遊攻略", "健保改革", "寵物醫療"]
  │ A, K, ROUNDS, PER = 500, 12, 20, 25
  │ QUOTA, DESK, OVER = 60, 4, 40
  │ STRATS = ["follow", "local_diversity", "hybrid"]
  │ 
  │ def neighbors(i):
  │     return [(i + d) % A for d in (-3, -2, -1, 1, 2, 3)]
  │ 
  │ def simulate(strategy):
  │     rng = random.Random(144)
  │     order = list(range(A))
  │     rng.shuffle(order)
  │     choice = [None] * A
  │     counts = [0] * K
  │     accepted = []
  │     snap = None
  │     for r in range(ROUNDS):
  │         desk = [0] * K
  │         ok = 0
  │         for i in order[r * PER:(r + 1) * PER]:
  │             nb = [choice[j] for j in neighbors(i) if choice[j] is not None]
  │             w = []
  │             for k in range(K):
  │                 c = nb.count(k)
  │                 x = (c + 1) * (counts[k] + 1) ** 1.5           # 跟風：鄰居在寫＋平台熱度
  │                 if strategy != "follow" and c >= 3:
  │                     x *= 0.1                                    # 本地剎車：鄰居已有 3 人寫
  │                 if strategy == "hybrid" and counts[k] >= QUOTA:
  │                     x = 0.0                                     # 中央邊界：全域配額 60 篇
  │                 w.append(x)
  │             k = rng.choices(range(K), weights=w)[0]
  │             choice[i] = k
  │             counts[k] += 1
  │             desk[k] += 1
  │             if desk[k] <= DESK:
  │                 ok += 1
  │         accepted.append(ok)
  │         if r == 9:
  │             snap = {"choice": list(choice), "counts": list(counts), "next": order[10 * PER:11 * PER]}
  │     return counts, accepted, snap
  │ 
  │ def metrics(counts, accepted):
  │     top = max(counts) / A
  │     dup = sum(max(0, c - OVER) for c in counts) / A
  │     mean = sum(accepted) / len(accepted)
  │     sd = (sum((a - mean) ** 2 for a in accepted) / len(accepted)) ** 0.5
  │     return top, dup, mean, sd / mean
  │ 
  │ results = {}
  │ print(f"{A} 個寫作代理、{K} 個話題；環狀排列，每人只看左右各 3 位；{ROUNDS} 輪 × 每輪 {PER} 人決定寫什麼")
  │ print(f"權重 =（鄰居中寫該話題人數 + 1）×（平台累積篇數 + 1）^1.5；每個話題每輪審稿台只收 {DESK} 篇")
  │ print(f"重複率 = 超過 {OVER} 篇的話題多出來的篇數 / 總篇數；hybrid 每題全域配額 {QUOTA} 篇")
  │ print()
  │ print(" 策略             | 最大話題占比 | 重複率 | 每輪審稿通過 | 變異係數 | 前三名話題（篇數）")
  │ print("-" * 104)
  │ for s in STRATS:
  │     counts, accepted, snap = simulate(s)
  │     top, dup, mean, cv = metrics(counts, accepted)
  │     rank = sorted(range(K), key=lambda k: -counts[k])[:3]
  │     top3 = "、".join(TOPICS[k] + "(" + str(counts[k]) + ")" for k in rank)
  │     results[s] = {"counts": counts, "snap": snap, "max_share": round(top, 4), "dup_rate": round(dup, 4),
  │                   "accept_mean": round(mean, 2), "cv": round(cv, 4)}
  │     print(f" {s:<16} | {top:>12.1%} | {dup:>6.1%} | {mean:>12.1f} | {cv:>8.3f} | {top3}")
  │ 
  │ fs = results["follow"]["snap"]
  │ fc, fcnt = fs["choice"], fs["counts"]
  │ agent = max(fs["next"], key=lambda i: sum(1 for j in neighbors(i) if fc[j] is not None))
  │ nb_ids = [fc[j] for j in neighbors(agent) if fc[j] is not None]
  │ nb_view = [TOPICS[fc[j]] if fc[j] is not None else "（還沒寫）" for j in neighbors(agent)]
  │ heat = [[TOPICS[k], fcnt[k]] for k in sorted(range(K), key=lambda k: -fcnt[k])[:5]]
  │ nb_top = TOPICS[max(sorted(set(nb_ids)), key=nb_ids.count)] if nb_ids else ""
  │ hyb = results["hybrid"]["snap"]["counts"]
  │ full = [TOPICS[k] for k in range(K) if hyb[k] >= QUOTA]
  │ 
  │ print()
  │ print(f"【給第 7 步的本地視角】follow 策略第 10 輪結束時，第 11 輪要下筆的代理 #{agent}")
  │ print("  左右各 3 位在寫：" + "、".join(nb_view))
  │ print("  鄰居中最多人寫：" + (nb_top if nb_top else "（鄰居都還沒寫）"))
  │ print("  平台熱度前 5：" + "；".join(h[0] + " " + str(h[1]) + " 篇" for h in heat))
  │ print("  hybrid 在同一時間點已額滿的話題：" + ("、".join(full) if full else "（還沒有）"))
  │ 
  │ state = {"topics": TOPICS, "quota": QUOTA,
  │          "metrics": {s: {"max_share": results[s]["max_share"], "dup_rate": results[s]["dup_rate"],
  │                          "accept_mean": results[s]["accept_mean"], "cv": results[s]["cv"]} for s in STRATS},
  │          "final_counts": {s: results[s]["counts"] for s in STRATS},
  │          "agent": agent, "neighbors_view": nb_view, "neighbors_top": nb_top, "heat_top5": heat,
  │          "hybrid_round10_counts": hyb}
  │ with open(STATE, "w", encoding="utf-8") as f:
  │     json.dump(state, f, ensure_ascii=False, indent=2)
  │ print()
  │ print("已寫入", STATE)
  │ print("follow 沒有任何剎車：熱度越高越多人寫、越多人寫熱度越高。虛擬世界沒有「不能同占一格」，剎車只能靠規則或配額補上。")
