  │ print("\n檢查點：", ckids, "| 從第", rstep, "步恢復 → 最終第", fstep, "步")
  │ print("隔離：", art["quarantined_contexts"], "| 阻擋：", art["blocked_tools"], "| 終止子任務：", killed)
  │ print("臨時政策：deny_tools", ov["deny_tools"], "deny_data", ov["deny_data"], "expires_after_step", ov["expires_after_step"], "最終前到期", ov["expired_before_final"])
  │ print("補償：", mr["record_id"], "deleted", mr["deleted"], "|", mr["tombstone_reason"])
  │ print("證據帳本：", ev["events"], "筆，驗證", ev["verified"], "，中斷動作", ev["interrupts"])
  │ print("重播：符合檢查點", rp["matches_checkpoint"], "| 安全前綴", rp["safe_prefix"])
  │ dt, dd, de = ov["deny_tools"], ov["deny_data"], ov["expires_after_step"]
  │ nev, ver = ev["events"], ev["verified"]
  │ rid, rdel, rwhy = mr["record_id"], mr["deleted"], mr["tombstone_reason"]
  │ md = "\n".join(["# ch08 執行期操控時間線（自動整理）", "", "| 步數 | 動作 | 決策 | 觸發原因 | 留下的控制／證據 |", "|---|---|---|---|---|", *rows, "",
  │     f"- 檢查點 {ckids}；從第 {rstep} 步恢復，最終第 {fstep} 步；證據帳本 {nev} 筆，驗證 {ver}。",
  │     f"- 臨時政策：deny_tools={dt}、deny_data={dd}、expires_after_step={de}；scenario.py 的 _overlay_active 用 step <= expires_after_step 判斷，core 的 inject_policy 另記秒數 expires_at，但沒人檢查。",
  │     f"- 為什麼 kill 不一直 block：子任務 {killed} 會一直重試被擋的寄信，無限重試本身就是風險（耗資源、等待繞過的機會）；終止子任務，父任務照樣從檢查點恢復。",
  │     f"- 補償：草稿 {rid} 被標成墓碑（deleted={rdel}，原因：{rwhy}）；之後讀不到，但帳本仍留著寫入與回滾，事後稽核看得到。直接刪掉就沒有這些紀錄。"])
  │ (od / "steering-timeline.md").write_text(md, encoding="utf-8")
  │ print("\n已存：practice/ch08/interactive/run.json、steering-timeline.md")
