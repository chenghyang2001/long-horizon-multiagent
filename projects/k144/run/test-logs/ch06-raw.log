  │         adj[a].add(b)
  │         adj[b].add(a)
  │         added += 1
  │ 
  │ def rewire():
  │     for _ in range(300):
  │         a = random.randrange(N)
  │         b = random.choice(sorted(adj[a]))
  │         c = random.choices(NODES, weights=[len(adj[v]) for v in NODES])[0]
  │         if c == a or c == b or c in adj[a]:
  │             continue
  │         if len(adj[c]) <= len(adj[b]) or len(adj[b]) <= 1:
  │             continue
  │         adj[a].discard(b)
  │         adj[b].discard(a)
  │         adj[a].add(c)
  │         adj[c].add(a)
  │         if len(bfs(adj, a)) == N:
  │             return True
  │         adj[a].discard(c)
  │         adj[c].discard(a)
