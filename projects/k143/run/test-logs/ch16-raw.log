        / ignoring(category) group_left sum(increase(llm_requests_total[7d] offset 7d))
      > 0.01
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: 某拒答類別佔總請求的比率比上週高 1 個百分點以上


