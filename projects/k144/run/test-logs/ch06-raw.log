  │     lam, tag = label(k)
  │     fin = run(k)[-1][1]
  │     mean = sum(fin) / 3
  │     result["sweep"].append([k, round(lam, 2), tag, mean])
  │     print(f" {k:>6.2f} | {lam:>+6.2f} | {tag:<8} | {mean:>18.4g} | {1 + DT * lam:>10.3f}")
  │ print()
