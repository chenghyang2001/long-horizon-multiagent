  │                     ax[j] += vx[i]
  │                     ay[j] += vy[i]
  │                     cx[i] += dx
  │                     cy[i] += dy
  │                     cx[j] -= dx
  │                     cy[j] -= dy
  │         nvx = [0.0] * n
