  │     verdict = "漏報！" if (kind == "真秘密" and not hit) else ("誤報！" if (kind == "無害" and hit) else "正確")
  │     miss += verdict == "漏報！"; false_hit += verdict == "誤報！"
  │     print(f"  {s:<38}{kind:<6}{str(hit):<8}{verdict}")
  │ print(f"\n結論：{miss} 個漏報、{false_hit} 個誤報")
▶ 執行結果：
def looks_like_secret(value: str) -> bool:
    lowered = value.lower()
    markers = ("api_key", "secret", "token=", "password", "private_key")
    return any(marker in lowered for marker in markers)

  字串                                    實際    偵測到?    結論
  api_key=abc                           真秘密   True    正確
  sk-live-abcdef123456                  真秘密   False   漏報！
  密碼是 hunter2                           真秘密   False   漏報！
  Bearer eyJhbGciOi...                  真秘密   False   漏報！
  api key: abc123                       真秘密   False   漏報！
  PASSWORD=Hunter2                      真秘密   True    正確
  這份新聞稿談的是 secret menu 促銷活動             無害    True    誤報！

結論：4 個漏報、1 個誤報

